{
  "name": "tinkermonkey808",
  "private": true,
  "version": "0.0.0",
  "description": "Japanese Freq",
  "author": "Kaleb Loo",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "node /app/server.js",
    "docker:build": "npm-run-all --parallel docker:build:*",
    "docker:build:server": "docker build . -f Dockerfile -t japanse-freq-server",
    "docker:push": "docker tag japanse-freq-server:latest tinkermonkey808/japanse-freq-server:latest && docker push tinkermonkey808/japanse-freq-server:latest",
    "docker:compose": "docker compose up",
    "docker:clean": "docker compose down & docker system prune -f",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@types/css-modules": "^1.0.5",
    "axios": "^1.3.4",
    "dompurify": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^6.9.0",
    "react-router-dom": "^6.9.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.3.1",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "express": "^4.18.2",
    "jsdom": "^24.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "typescript": "^4.9.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.2.3",
    "vitest": "^1.6.0"
  }
}
