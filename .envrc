# .envrc

# 1. Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Brew not found. Please install Homebrew: https://brew.sh/"
    return 1
fi

# 2. Check for Python 3.12 and install if missing
if ! brew list python@3.12 &> /dev/null; then
    echo "Python 3.12 not found. Installing via Homebrew..."
    brew install python@3.12
else
    echo "Python 3.12 is already installed."
fi

# 3. Create a virtual environment if it doesn't exist
if [ ! -d ".venv" ]; then
    echo "Creating virtual environment in .venv..."
    $(brew --prefix python@3.12)/bin/python3.12 -m venv .venv
fi

# 4. Activate the virtual environment
layout python .venv/bin/python
